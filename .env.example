# Copy to .env.local and fill in real values.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives website enquiries
ENQUIRY_TO_EMAIL=hirematrix.info@gmail.com

# Sender address — its domain must be verified in Resend
ENQUIRY_FROM_EMAIL="HireMatrix Website <enquiries@hirematrixcareers.in>"
